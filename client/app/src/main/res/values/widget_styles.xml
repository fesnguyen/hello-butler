<resources>
    <dimen name="widget_action_text_size">13sp</dimen>
    <dimen name="widget_response_text_size">17sp</dimen>
    <style name="Widget.Home" parent="@android:style/Widget.Button">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">6dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowRadius">2</item>
    </style>
    <style name="Widget.Playback" parent="Widget.Home">
        <item name="android:background">@drawable/widget_playback</item>
        <item name="android:textSize">12sp</item>
        <item name="android:padding">8dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
