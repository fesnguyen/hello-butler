# Development example: copy to .env.dev and replace placeholders.
POSTGRES_DB=hello_butler_dev
POSTGRES_USER=hello_butler
POSTGRES_PASSWORD=replace-with-local-password
SHOWCASE_DB=showcase_dev
SHOWCASE_USER=showcase_dev
SHOWCASE_PASSWORD=replace-with-showcase-password
SHOWCASE_HOST=localhost
SHOWCASE_PORT=5433
SHOWCASE_HTTP_HOST=127.0.0.1
SHOWCASE_HTTP_PORT=8001
DATABASE_URL=postgresql+asyncpg://hello_butler:replace-with-local-password@localhost:5433/hello_butler_dev
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Production: POSTGRES_DB=hello_butler, SHOWCASE_DB=showcase,
# Production Butler DATABASE_URL uses postgres:5432; Showcase uses SHOWCASE_HOST=postgres.
