# Development example: copy to .env.dev and replace placeholders.
POSTGRES_DB=hello_butler_dev
POSTGRES_USER=hello_butler
POSTGRES_PASSWORD=replace-with-local-password
SHOWCASE_DB=showcase_dev
SHOWCASE_USER=showcase_dev
SHOWCASE_PASSWORD=replace-with-showcase-password
SHOWCASE_HOST=localhost
SHOWCASE_PORT=5433
SHOWCASE_HTTP_HOST=127.0.0.1
SHOWCASE_HTTP_PORT=8001
DATABASE_URL=postgresql+asyncpg://hello_butler:replace-with-local-password@localhost:5433/hello_butler_dev
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Production: POSTGRES_DB=hello_butler, SHOWCASE_DB=showcase,
# Production Butler DATABASE_URL uses postgres:5432; Showcase uses SHOWCASE_HOST=postgres.

# AdminJS: use local placeholders only; generate a real scrypt hash separately.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH=scrypt:<32 hex salt characters>:<128 hex hash characters>
# ADMIN_SESSION_SECRET=<random secret of at least 32 characters>
# ADMIN_TOTP_ENCRYPTION_KEY=<independent 32-byte random key encoded as 64 hex characters>
# PORT=3000
# Admin sessions and two-step verification use SHOWCASE_* in the isolated admin_auth schema.
# Preserve the TOTP encryption key across deployments; see ADMIN_AUTHORIZATION.md for setup/upgrade.
# Production start enforces NODE_ENV=production; Secure cookies are the default.
# Existing Compose uses an explicit localhost-only ADMIN_LOCAL_HTTP exception.
# Behind a trusted HTTPS reverse proxy on the same host:
# ADMIN_TRUST_PROXY=loopback
